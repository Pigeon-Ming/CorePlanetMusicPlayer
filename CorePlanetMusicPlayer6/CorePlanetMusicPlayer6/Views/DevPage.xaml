<Page
    x:Class="CorePlanetMusicPlayer6.Views.DevPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UWPTools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devcontrols="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:local="using:CorePlanetMusicPlayer6.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:controls1="using:CorePlanetMusicPlayer6.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <!--  库、音乐、正在播放、播放队列、艺术家、专辑、流派、播放列表  -->
        <Hub>
            <Hub.Resources>
                <Style TargetType="HubSection">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </Hub.Resources>
            <HubSection Header="开发者工具">
                <DataTemplate>
                    <controls:DevToolsControl />
                </DataTemplate>
            </HubSection>
            <HubSection Width="400" Header="本地音乐库来源">
                <DataTemplate>
                    <devcontrols:LibraryControl />
                </DataTemplate>
            </HubSection>
            <HubSection Width="400" Header="音乐库">
                <DataTemplate>
                    <devcontrols:MusicLibraryControl />
                </DataTemplate>
            </HubSection>
            <HubSection Width="300" Header="播放控制">
                <DataTemplate>
                    <devcontrols:PlayingControl />
                </DataTemplate>
            </HubSection>
            <HubSection Width="400" Header="播放队列">
                <DataTemplate>
                    <devcontrols:PlayQueueControl />
                </DataTemplate>
            </HubSection>
            <HubSection
                Width="400"
                VerticalContentAlignment="Stretch"
                Header="艺术家">
                <DataTemplate>
                    <devcontrols:ArtistsControl />
                </DataTemplate>
            </HubSection>
            <HubSection
                Width="400"
                VerticalContentAlignment="Stretch"
                Header="专辑">
                <DataTemplate>
                    <devcontrols:AlbumsControl />
                </DataTemplate>
            </HubSection>
            <HubSection
                Width="400"
                VerticalContentAlignment="Stretch"
                Header="流派">
                <DataTemplate>
                    <devcontrols:GenresControl />
                </DataTemplate>
            </HubSection>
            <HubSection
                Width="400"
                VerticalContentAlignment="Stretch"
                Header="年份">
                <DataTemplate>
                    <devcontrols:YearsControl />
                </DataTemplate>
            </HubSection>
            <HubSection Width="400" Header="播放统计">
                <DataTemplate>
                    <devcontrols:PlayRecordsControl />
                </DataTemplate>
            </HubSection>
            <HubSection Width="400" Header="播放列表">
                <DataTemplate>
                    <devcontrols:PlaylistsControl />
                </DataTemplate>
            </HubSection>
            <HubSection Width="400" Header="歌词">
                <DataTemplate>
                    <devcontrols:LyricControl />
                </DataTemplate>
            </HubSection>
        </Hub>
    </Grid>
</Page>
