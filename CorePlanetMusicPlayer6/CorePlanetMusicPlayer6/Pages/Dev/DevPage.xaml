<Page
    x:Class="CorePlanetMusicPlayer6.Pages.Dev.DevPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:local="using:CorePlanetMusicPlayer6.Pages.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Hub Header="CorePlanetMusicPlayer 6 Dev">
            <Hub.Resources>
                <Style TargetType="HubSection">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinWidth" Value="400" />
                </Style>
            </Hub.Resources>
            <HubSection Header="开发者">
                <DataTemplate>
                    <dev:DevToolsControl />
                </DataTemplate>
            </HubSection>
            <HubSection Header="库">
                <DataTemplate>
                    <dev:LibraryControl />
                </DataTemplate>
            </HubSection>
            <HubSection Header="正在播放">
                <DataTemplate>
                    <TextBlock Text="占位" />
                </DataTemplate>
            </HubSection>
            <HubSection Header="播放队列">
                <DataTemplate>
                    <TextBlock Text="占位" />
                </DataTemplate>
            </HubSection>
            <HubSection Header="音乐">
                <DataTemplate>
                    <dev:MusicControl />
                </DataTemplate>
            </HubSection>
            <HubSection Header="专辑">
                <DataTemplate>
                    <TextBlock Text="占位" />
                </DataTemplate>
            </HubSection>
            <HubSection Header="艺术家">
                <DataTemplate>
                    <TextBlock Text="占位" />
                </DataTemplate>
            </HubSection>
            <HubSection Header="最近">
                <DataTemplate>
                    <TextBlock Text="占位" />
                </DataTemplate>
            </HubSection>
            <HubSection Header="统计">
                <DataTemplate>
                    <TextBlock Text="占位" />
                </DataTemplate>
            </HubSection>
        </Hub>
    </Grid>
</Page>
