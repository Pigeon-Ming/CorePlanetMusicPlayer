<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.EqualizerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="均衡器" />
            <ToggleSwitch Name="EqualizerToggleSwitch" Toggled="EqualizerToggleSwitch_Toggled" />
            <ComboBox
                Name="PresetsComboBox"
                HorizontalAlignment="Right"
                SelectionChanged="PresetsComboBox_SelectionChanged" />
        </StackPanel>
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <Grid Margin="0,0,0,8">
                <Grid.Resources>
                    <Style TargetType="Slider">
                        <Setter Property="Orientation" Value="Vertical" />
                        <Setter Property="Minimum" Value="-9" />
                        <Setter Property="Maximum" Value="6" />
                        <Setter Property="StepFrequency" Value="1" />
                        <Setter Property="Value" Value="0" />
                        <Setter Property="Margin" Value="8" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Slider
                    x:Name="eq0"
                    Grid.Column="0"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq1"
                    Grid.Column="1"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq2"
                    Grid.Column="2"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq3"
                    Grid.Column="3"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq4"
                    Grid.Column="4"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq5"
                    Grid.Column="5"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq6"
                    Grid.Column="6"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq7"
                    Grid.Column="7"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq8"
                    Grid.Column="8"
                    ValueChanged="EqSlider_ValueChanged" />
                <Slider
                    x:Name="eq9"
                    Grid.Column="9"
                    ValueChanged="EqSlider_ValueChanged" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="30Hz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="64Hz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="125Hz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="250Hz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="4"
                    Text="500Hz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="5"
                    Text="1kHz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="6"
                    Text="2kHz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="7"
                    Text="4kHz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="8"
                    Text="8kHz" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="9"
                    Text="16kHz" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
