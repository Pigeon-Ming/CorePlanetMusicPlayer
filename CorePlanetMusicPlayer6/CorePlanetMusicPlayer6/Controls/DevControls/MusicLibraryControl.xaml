<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.MusicLibraryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:CorePlanetMusicPlayer.Models"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400"
    VerticalAlignment="Stretch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <!--<Button Content="重新扫描音乐库" Name="ScanMusicLibrary" Click="ScanMusicLibrary_Click"/>-->
            <Button Content="刷新音乐来源" Name="RefreshSourceListButton" Click="RefreshSourceListButton_Click"/>
            <ComboBox PlaceholderText="选择音乐来源" Name="MusicSourceComboBox" SelectionChanged="MusicSourceComboBox_SelectionChanged"/>
            <Button Content="添加流式传输音乐" Name="AddStreamMusicButton" Click="AddStreamMusicButton_Click"/>
        </StackPanel>
        <ListView Grid.Row="1" Name="MusicListView" DoubleTapped="MusicListView_DoubleTapped" RightTapped="MusicListView_RightTapped" VerticalAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IMusic">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" Grid.Column="0" Margin="4,0,4,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}" Grid.Row="1" Margin="4,0,4,0" TextTrimming="CharacterEllipsis" Grid.Column="0" Grid.ColumnSpan="2"/>
                        <TextBlock Text="{Binding Duration}" Grid.Column="1"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="保存至播放列表" Name="Menu_SaveToPlaylist" Click="Menu_SaveToPlaylist_Click"/>
                    <MenuFlyoutItem Text="从音乐库中移除" Name="Menu_Remove" Click="Menu_Remove_Click"/>
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>
    </Grid>
</UserControl>
