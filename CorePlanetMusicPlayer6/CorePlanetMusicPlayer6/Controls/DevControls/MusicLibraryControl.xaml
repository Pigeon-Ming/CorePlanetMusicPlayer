<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.MusicLibraryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CorePlanetMusicPlayer.Models"
    VerticalAlignment="Stretch"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <!--<Button Content="重新扫描音乐库" Name="ScanMusicLibrary" Click="ScanMusicLibrary_Click"/>-->
            <Button
                Name="RefreshSourceListButton"
                Click="RefreshSourceListButton_Click"
                Content="刷新音乐来源" />
            <ComboBox
                Name="MusicSourceComboBox"
                PlaceholderText="选择音乐来源"
                SelectionChanged="MusicSourceComboBox_SelectionChanged" />
            <Button
                Name="AddStreamMusicButton"
                Click="AddStreamMusicButton_Click"
                Content="添加流式传输音乐" />
        </StackPanel>
        <ListView
            Name="MusicListView"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            DoubleTapped="MusicListView_DoubleTapped"
            RightTapped="MusicListView_RightTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IMusic">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="4,0,4,0"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="4,0,4,0"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Name="Menu_SaveToPlaylist"
                        Click="Menu_SaveToPlaylist_Click"
                        Text="保存至播放列表" />
                    <MenuFlyoutItem
                        Name="Menu_Remove"
                        Click="Menu_Remove_Click"
                        Text="从音乐库中移除" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>
    </Grid>
</UserControl>
