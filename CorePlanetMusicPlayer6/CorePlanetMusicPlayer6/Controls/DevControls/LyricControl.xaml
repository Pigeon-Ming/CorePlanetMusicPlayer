<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.LyricControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid>
                <CommandBar DefaultLabelPosition="Right">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton Label="打开文件" Name="Menu_OpenFile" Click="Menu_OpenFile_Click"/>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>
            <Grid Grid.Row="1">
                <ScrollViewer Name="LyricsScrollViewer">
                    <StackPanel Name="LyricsStackPanel">
                        
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
