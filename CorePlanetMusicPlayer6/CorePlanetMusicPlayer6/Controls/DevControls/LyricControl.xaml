<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.LyricControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid>
                <CommandBar DefaultLabelPosition="Right">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            Name="Menu_OpenFile"
                            Click="Menu_OpenFile_Click"
                            Label="打开文件" />
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>
            <Grid Grid.Row="1">
                <ScrollViewer Name="LyricsScrollViewer">
                    <StackPanel Name="LyricsStackPanel" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
