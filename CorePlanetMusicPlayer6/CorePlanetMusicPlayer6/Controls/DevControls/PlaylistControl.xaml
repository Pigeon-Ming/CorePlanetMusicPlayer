<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.PlaylistControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:CorePlanetMusicPlayer.Models"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel>
                <Border BorderThickness="1" BorderBrush="Gray" HorizontalAlignment="Center">
                    <Image Name="CoverImage" Height="100" Width="100"/>
                </Border>
                <TextBlock Name="TitleTextBlock"/>
                <TextBox Header="简介" Name="DescriptionTextBox"/>
                <TextBlock Name="CountTextBlock"/>
                <TextBlock Name="CoverMessageTextBlock"/>
                <Button Content="设置网络封面">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel>
                                <TextBox Name="Cover_StreamCoverUrlTextBlock"/>
                                <Button Name="Cover_SetStreamCoverButton" Click="Cover_SetStreamCoverButton_Click"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="设置本地封面" Name="Cover_SetLocalCoverButton" Click="Cover_SetLocalCoverButton_Click"/>
                <Button Content="恢复为默认封面" Name="Cover_ResetToDefaultButton" Click="Cover_ResetToDefaultButton_Click"/>
            </StackPanel>
        </ScrollViewer>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Remove" Label="移除选中项" Name="Menu_RemoveSelectedItem" Click="Menu_RemoveSelectedItem_Click"/>
                <AppBarButton Icon="Save" Label="保存播放列表信息" Name="Menu_SavePlaylistInfo" Click="Menu_SavePlaylistInfo_Click"/>
            </CommandBar.PrimaryCommands>
        </CommandBar>
        <ListView Name="MusicListView" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IMusic">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}"/>
                        <TextBlock Text="{Binding Artist}" Grid.Row="1"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
