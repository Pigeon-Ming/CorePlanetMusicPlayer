<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.PlaylistControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CorePlanetMusicPlayer.Models"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel>
                <Border
                    HorizontalAlignment="Center"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <Image
                        Name="CoverImage"
                        Width="100"
                        Height="100" />
                </Border>
                <TextBlock Name="TitleTextBlock" />
                <TextBox Name="DescriptionTextBox" Header="简介" />
                <TextBlock Name="CountTextBlock" />
                <TextBlock Name="CoverMessageTextBlock" />
                <Button Content="设置网络封面">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel>
                                <TextBox Name="Cover_StreamCoverUrlTextBlock" />
                                <Button Name="Cover_SetStreamCoverButton" Click="Cover_SetStreamCoverButton_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Name="Cover_SetLocalCoverButton"
                    Click="Cover_SetLocalCoverButton_Click"
                    Content="设置本地封面" />
                <Button
                    Name="Cover_ResetToDefaultButton"
                    Click="Cover_ResetToDefaultButton_Click"
                    Content="恢复为默认封面" />
            </StackPanel>
        </ScrollViewer>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Name="Menu_RemoveSelectedItem"
                    Click="Menu_RemoveSelectedItem_Click"
                    Icon="Remove"
                    Label="移除选中项" />
                <AppBarButton
                    Name="Menu_SavePlaylistInfo"
                    Click="Menu_SavePlaylistInfo_Click"
                    Icon="Save"
                    Label="保存播放列表信息" />
            </CommandBar.PrimaryCommands>
        </CommandBar>
        <ListView Name="MusicListView" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IMusic">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Grid.Row="1" Text="{Binding Artist}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
