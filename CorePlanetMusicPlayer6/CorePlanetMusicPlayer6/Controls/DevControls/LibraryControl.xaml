<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.LibraryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Icon="Refresh"
                    Label="读取文件夹列表" />
                <AppBarButton
                    Name="AddButton"
                    Click="AddButton_Click"
                    Icon="Add"
                    Label="添加" />
                <AppBarButton
                    Name="RemoveButton"
                    Click="RemoveButton_Click"
                    Icon="Remove"
                    Label="移除" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Name="TryOpenRemovableDeviceFileViaPathButton"
                    Click="TryOpenRemovableDeviceFileViaPathButton_Click"
                    Icon="OpenFile"
                    Label="尝试读取可移动设备中的文件" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <TextBlock
            Margin="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="音乐库位置" />
        <ListView Name="FolderListView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Token}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Text="{Binding StorageFolder.Path}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
