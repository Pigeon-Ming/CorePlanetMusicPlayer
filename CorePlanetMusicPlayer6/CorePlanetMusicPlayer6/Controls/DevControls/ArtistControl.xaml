<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.ArtistControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CorePlanetMusicPlayer.Models"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Image Name="PictureImage" />
        <ScrollViewer>
            <StackPanel>
                <Button Content="修改艺术家图片" />
                <TextBlock Name="NameTextBlock" />
                <TextBox Name="DescriptionTextBox" Header="简介" />
                <TextBlock Name="MusicCountTextBlock" />
                <TextBlock Name="AlbumsCountTextBlock" />
                <Button Content="保存简介信息" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="歌曲" />
            <TextBlock Grid.Column="1" Text="专辑" />
            <ListView Name="MusicListView" Grid.Row="1">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:IMusic">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Grid.Row="1" Text="{Binding Album}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView
                Name="AlbumsListView"
                Grid.Row="1"
                Grid.Column="1">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Album">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Grid.Row="1">
                                <Run Text="{Binding MusicCount}" />
                                <Run>首歌曲</Run>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
