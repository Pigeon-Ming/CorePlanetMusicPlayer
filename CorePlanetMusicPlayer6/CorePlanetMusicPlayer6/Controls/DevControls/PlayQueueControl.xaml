<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.PlayQueueControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CorePlanetMusicPlayer.Models"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton
                Name="LocatePlayingButton"
                Click="LocatePlayingButton_Click"
                Label="定位正在播放">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE819;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Name="RemoveSelectedItemButton"
                Click="RemoveSelectedItemButton_Click"
                Label="移除选中项">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
        <ListView
            Name="MainListView"
            Grid.Row="1"
            LayoutUpdated="MainListView_LayoutUpdated">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IMusic">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Name="PlayingIcon"
                            Grid.RowSpan="2"
                            Margin="8,0,4,0"
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xF61F;"
                            Visibility="Collapsed" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="4,0,4,0"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="4,0,4,0"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Duration}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
