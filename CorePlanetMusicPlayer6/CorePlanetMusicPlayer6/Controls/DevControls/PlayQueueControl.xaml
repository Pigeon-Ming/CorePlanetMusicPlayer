<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.PlayQueueControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:CorePlanetMusicPlayer.Models"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Name="LocatePlayingButton" Label="定位正在播放" Click="LocatePlayingButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE819;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Name="RemoveSelectedItemButton" Click="RemoveSelectedItemButton_Click" Label="移除选中项">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
        <ListView Grid.Row="1" Name="MainListView" LayoutUpdated="MainListView_LayoutUpdated">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IMusic">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="Segoe Fluent Icons" Name="PlayingIcon" Grid.RowSpan="2" Margin="8,0,4,0" Visibility="Collapsed" Glyph="&#xF61F;"/>
                        <TextBlock Text="{Binding Title}" Grid.Column="1" Margin="4,0,4,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}" Grid.Row="1" Margin="4,0,4,0" TextTrimming="CharacterEllipsis" Grid.Column="1" Grid.ColumnSpan="2"/>
                        <TextBlock Text="{Binding Duration}" Grid.Column="2"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
