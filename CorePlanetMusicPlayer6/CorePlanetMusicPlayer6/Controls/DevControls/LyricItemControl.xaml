<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.LyricItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Button Name="RootButton" x:FieldModifier="public" Background="Transparent" BorderBrush="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Name="LyricTextBlock" TextWrapping="WrapWholeWords" Opacity="0.5"/>
            <TextBlock Name="TranslationTextBlock" TextWrapping="WrapWholeWords" Grid.Row="1" Opacity="0.5"/>
        </Grid>
    </Button>
</UserControl>
