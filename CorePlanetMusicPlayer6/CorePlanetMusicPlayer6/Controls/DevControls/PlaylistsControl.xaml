<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.PlaylistsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CorePlanetMusicPlayer.Models"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="创建播放列表">
                    <AppBarButton.Flyout>
                        <Flyout>
                            <StackPanel>
                                <TextBox Name="NewPlaylistTextBox" />
                                <Button
                                    Name="CreateButton"
                                    Click="CreateButton_Click"
                                    Content="创建" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    Name="DeleteButton"
                    Click="DeleteButton_Click"
                    Icon="Delete"
                    Label="删除选中项" />
            </CommandBar.PrimaryCommands>
        </CommandBar>
        <ListView
            Name="PlaylistsListView"
            Grid.Row="1"
            SelectionChanged="PlaylistsListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Playlist">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Grid.Row="1">
                            <Run Text="{Binding Music.Count}" />
                            <Run Text="首歌曲" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <local:PlaylistControl x:Name="PlaylistControl" Grid.Row="2" />
    </Grid>
</UserControl>
