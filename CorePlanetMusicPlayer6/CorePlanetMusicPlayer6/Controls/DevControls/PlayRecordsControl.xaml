<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.PlayRecordsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CorePlanetMusicPlayer.Models"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel>
                <Button
                    Name="TestButton"
                    Click="TestButton_Click"
                    Content="测试" />
                <DatePicker Name="QueryDatePicker" />
                <Button
                    Name="QueryDateDataButton"
                    Click="QueryDateDataButton_Click"
                    Content="尝试获取指定年月日的数据" />
            </StackPanel>
        </ScrollViewer>
        <ListView Name="PlayRecordsListView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PlayRecord">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Artist}" />
                            <TextBlock Text="{Binding Album}" />
                            <TextBlock Text="{Binding Duration}" />
                            <TextBlock Text="{Binding DateTime}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
