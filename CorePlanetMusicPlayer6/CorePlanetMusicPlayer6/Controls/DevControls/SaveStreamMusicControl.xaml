<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.DevControls.SaveStreamMusicControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.DevControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel>
                <TextBox Header="URL" Name="URLTextBox"/>
                <TextBox Header="标题" Name="TitleTextBox"/>
                <TextBox Header="专辑" Name="AlbumTextBox"/>
                <TextBox Header="艺术家" Name="ArtistTextBox"/>
                <!--<TextBox Header="简介"/>-->
                <TextBox Header="比特率" Name="BitrateTextBox"/>
                <TextBox Header="音轨" Name="TrackTextBox"/>
                <TextBox Header="碟片" Name="DiscTextBox"/>
                <TextBox Header="发行年份" Name="YearTextBox"/>
                <ComboBox Header="流派" Name="GenreComboBox"/>
                <TextBox Header="封面url" Name="CoverURLTextBox"/>
                
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Content="保存" HorizontalAlignment="Stretch" Margin="8,8,8,4" Name="SaveButton" Click="SaveButton_Click"/>
        <Button Grid.Row="2" Content="取消" HorizontalAlignment="Stretch" Margin="8,0,8,8" Name="CancelButton" Click="CancelButton_Click"/>
    </Grid>
</UserControl>
