<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.PlayBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Button
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="56"
                    Height="56"
                    Margin="8"
                    Background="AliceBlue">
                    <Image Name="CoverImage" Source="{x:Bind ViewModel.CurrentMusicCover}" />
                </Grid>
                <Grid Grid.Column="1" Margin="8,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Bottom" Text="{x:Bind ViewModel.CurrentMusic.Title}" />
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        Text="{x:Bind ViewModel.CurrentMusic.Artist}" />
                </Grid>
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Name="PlayModeButton" Click="PlayModeButton_Click">
                        <FontIcon Glyph="{x:Bind ViewModel.CurrentPlayModeIconGlyph}" />
                    </Button>
                    <Button Click="{x:Bind ViewModel.PlayEngine.Previous}">
                        <FontIcon Glyph="&#xE892;" />
                    </Button>
                    <Button Click="{x:Bind ViewModel.PlayEngine.PlayPause}">
                        <FontIcon Glyph="{x:Bind ViewModel.PlayStateIconGlyph}" />
                    </Button>
                    <Button Click="{x:Bind ViewModel.PlayEngine.Next}">
                        <FontIcon Glyph="&#xE893;" />
                    </Button>
                    <Button>
                        <FontIcon Glyph="&#xE767;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
