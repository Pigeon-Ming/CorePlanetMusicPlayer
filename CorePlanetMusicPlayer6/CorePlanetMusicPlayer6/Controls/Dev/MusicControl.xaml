<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.MusicControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <CommandBar Name="MusicCommandBar">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Name="PlayButton"
                    Click="PlayButton_Click"
                    Label="播放选中项" />
                <AppBarToggleButton
                    Name="MultipleSelectionButton"
                    Click="MultipleSelectionButton_Click"
                    Label="多选" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Name="PlayNextButton"
                    Click="PlayNextButton_Click"
                    Label="下一曲播放" />
                <AppBarButton
                    Name="AddToPlayQueueButton"
                    Click="AddToPlayQueueButton_Click"
                    Label="加入播放队列" />
                <AppBarSeparator />
                <AppBarButton
                    Name="AddToPlaylistButton"
                    Click="AddToPlaylistButton_Click"
                    Label="加入播放列表" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <ListView
            Name="MusicListView"
            Grid.Row="1"
            SelectionChanged="MusicListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Grid.Row="1" Text="{Binding Artist}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="SelectionTextBlock" />
            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
