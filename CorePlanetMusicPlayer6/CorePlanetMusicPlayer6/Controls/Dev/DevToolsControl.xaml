<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.DevToolsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <Button
                Name="OpenLocalFolderButton"
                Click="OpenLocalFolderButton_Click"
                Content="打开内部文件夹" />
            <TextBlock Name="SystemInfoTextBlock" />
            <TextBlock Name="PackageInfoTextBlock" />
        </StackPanel>
    </Grid>
</UserControl>
