<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.PlayHistoryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Name="HistoryCommandBar" DefaultLabelPosition="Right">

            <AppBarButton
                Click="QueryButton_Click"
                Icon="Find"
                Label="按条件查询" />

            <AppBarButton
                Click="QueryAllButton_Click"
                Icon="AllApps"
                Label="查询全部" />

            <AppBarToggleButton
                Name="EnablePlaybackHistoryToggleButton"
                Click="EnablePlaybackHistoryToggleButton_Click"
                Label="启用播放历史服务" />
        </CommandBar>

        <StackPanel Grid.Row="1" Margin="12,8">

            <TextBlock Text="按本地时间查询；未勾选的时间边界不作限制。" TextWrapping="Wrap" />

            <CheckBox
                Name="UseStartTimeCheckBox"
                Margin="0,8,0,0"
                Checked="TimeFilterCheckBox_Changed"
                Content="限定开始时间"
                Unchecked="TimeFilterCheckBox_Changed" />

            <DatePicker
                Name="StartDatePicker"
                HorizontalAlignment="Stretch"
                CalendarIdentifier="GregorianCalendar" />

            <TimePicker
                Name="StartTimePicker"
                Margin="0,8,0,0"
                ClockIdentifier="24HourClock"
                Header="时、分"
                MinuteIncrement="1" />

            <CheckBox
                Name="UseEndTimeCheckBox"
                Margin="0,12,0,0"
                Checked="TimeFilterCheckBox_Changed"
                Content="限定结束时间（包含这一分钟）"
                Unchecked="TimeFilterCheckBox_Changed" />

            <DatePicker
                Name="EndDatePicker"
                HorizontalAlignment="Stretch"
                CalendarIdentifier="GregorianCalendar" />

            <TimePicker
                Name="EndTimePicker"
                Margin="0,8,0,0"
                ClockIdentifier="24HourClock"
                Header="时、分"
                MinuteIncrement="1" />
        </StackPanel>

        <TextBlock
            Name="SummaryTextBlock"
            Grid.Row="2"
            Margin="12,8"
            Text="播放历史"
            TextWrapping="Wrap" />

        <ListView
            Name="HistoryListView"
            Grid.Row="3"
            SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6">
                        <TextBlock
                            FontSize="18"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />

                        <TextBlock Text="{Binding ArtistText}" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding AlbumText}" TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,4,0,0"
                            Opacity="0.7"
                            Text="{Binding PlayedAtText}" />

                        <TextBlock
                            Opacity="0.7"
                            Text="{Binding AvailabilityText}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,4,0,0"
                            Text="{Binding DurationText}"
                            TextWrapping="Wrap" />

                        <TextBlock Text="{Binding CompletionText}" />

                        <TextBlock
                            Opacity="0.6"
                            Text="{Binding HistoryIdText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="4"
            Margin="12,8"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
