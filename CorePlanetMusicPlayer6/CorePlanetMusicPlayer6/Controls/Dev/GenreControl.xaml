<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.GenreControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Name="GenreTitleTextBlock" TextWrapping="Wrap" />

            <TextBlock Name="GenreTextBlock" TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            Name="GenreMusicListView"
            Grid.Row="1"
            SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding ArtistName}" />
                        <TextBlock Text="{Binding AlbumTitle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="2"
            Margin="0,8,0,0"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
