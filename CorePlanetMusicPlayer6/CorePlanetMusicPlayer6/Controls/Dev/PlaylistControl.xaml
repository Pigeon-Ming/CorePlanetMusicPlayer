<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.PlaylistControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d"
    Unloaded="UserControl_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            MaxHeight="200"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="8">
                <TextBox Name="PlaylistNameTextBox" Header="播放列表名称" />

                <TextBox
                    Name="PlaylistDescriptionTextBox"
                    AcceptsReturn="True"
                    Header="简介"
                    TextWrapping="Wrap" />

                <Button
                    Name="SaveInfoButton"
                    Click="SaveInfoButton_Click"
                    Content="保存资料" />

                <TextBlock Name="PlaylistSummaryTextBlock" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                Name="MusicToAddComboBox"
                HorizontalAlignment="Stretch"
                PlaceholderText="选择要添加的歌曲"
                SelectionChanged="MusicToAddComboBox_SelectionChanged">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding ArtistName}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button
                Name="AddMusicButton"
                Grid.Column="1"
                Margin="8,0,0,0"
                Click="AddMusicButton_Click"
                Content="添加歌曲" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,0"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                Name="RemoveItemButton"
                Click="RemoveItemButton_Click"
                Content="移除条目" />

            <Button
                Name="MoveUpButton"
                Click="MoveUpButton_Click"
                Content="上移" />

            <Button
                Name="MoveDownButton"
                Click="MoveDownButton_Click"
                Content="下移" />
        </StackPanel>

        <ListView
            Name="PlaylistItemsListView"
            Grid.Row="3"
            SelectionChanged="PlaylistItemsListView_SelectionChanged"
            SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Number}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding ArtistName}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="4"
            Margin="0,8,0,0"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
