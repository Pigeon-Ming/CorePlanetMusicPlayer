<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.AlbumControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <CollectionViewSource x:Name="AlbumMusicSource" IsSourceGrouped="True" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBlock Name="AlbumTitleTextBlock" TextWrapping="Wrap" />
                <TextBlock Name="AlbumArtistNameTextBlock" TextWrapping="Wrap" />
                <TextBlock Name="AlbumTextBlock" TextWrapping="Wrap" />
                <TextBox
                    Name="AlbumDescriptionTextBox"
                    AcceptsReturn="True"
                    Header="专辑简介"
                    IsEnabled="False"
                    TextWrapping="Wrap" />
                <Button
                    Name="SaveAlbumButton"
                    Click="SaveAlbumButton_Click"
                    Content="保存" />
            </StackPanel>
        </ScrollViewer>
        <ListView
            x:Name="AlbumMusicListView"
            Grid.Row="1"
            ItemsSource="{Binding Source={StaticResource AlbumMusicSource}}"
            SelectionMode="Single">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,8,0,4"
                                FontSize="18"
                                Text="{Binding Key}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Metadata.TrackNumber}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding ArtistName}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="2"
            Margin="0,8,0,0"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
