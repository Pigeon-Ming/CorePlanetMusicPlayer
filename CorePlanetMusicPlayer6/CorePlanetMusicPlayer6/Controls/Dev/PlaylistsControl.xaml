<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.PlaylistsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <CommandBar Name="PlaylistsCommandBar" DefaultLabelPosition="Right">

            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Name="ReloadPlaylistsButton"
                    Click="ReloadPlaylistsButton_Click"
                    Icon="Refresh"
                    Label="刷新列表" />

                <AppBarButton
                    Name="CreatePlaylistButton"
                    Click="CreatePlaylistButton_Click"
                    Icon="Add"
                    Label="新建播放列表" />

                <AppBarButton
                    Name="PlayButton"
                    Click="PlayButton_Click"
                    Icon="Play"
                    IsEnabled="False"
                    Label="播放选中项" />
            </CommandBar.PrimaryCommands>

            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Name="PlayNextButton"
                    Click="PlayNextButton_Click"
                    IsEnabled="False"
                    Label="下一首播放" />

                <AppBarButton
                    Name="AddToPlayQueueButton"
                    Click="AddToPlayQueueButton_Click"
                    IsEnabled="False"
                    Label="添加到播放队列" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <StackPanel
            Name="CreatePlaylistPanel"
            Grid.Row="1"
            Spacing="8">

            <TextBox
                Name="NewPlaylistNameTextBox"
                Header="新播放列表名称"
                PlaceholderText="请输入名称" />

            <TextBox
                Name="NewPlaylistDescriptionTextBox"
                MaxHeight="120"
                AcceptsReturn="True"
                Header="简介（可选）"
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            Name="PlaylistsListView"
            Grid.Row="2"
            SelectionChanged="PlaylistsListView_SelectionChanged"
            SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" />

                        <TextBlock>
                            <Run Text="{Binding ItemCount}" />
                            <Run Text=" 个条目" />
                        </TextBlock>

                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="3"
            TextWrapping="Wrap" />

        <local:PlaylistControl x:Name="PlaylistDetailsControl" Grid.Row="4" />
    </Grid>
</UserControl>
