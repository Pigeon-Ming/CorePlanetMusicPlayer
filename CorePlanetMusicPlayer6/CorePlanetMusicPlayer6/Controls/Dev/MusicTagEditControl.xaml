<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.MusicTagEditControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Name="ReloadButton"
                    Click="ReloadButton_Click"
                    Icon="Refresh"
                    IsEnabled="False"
                    Label="重新加载" />

                <AppBarButton
                    Name="SaveButton"
                    Click="SaveButton_Click"
                    Icon="Save"
                    IsEnabled="False"
                    Label="保存标签" />
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <StackPanel
            Grid.Row="1"
            Margin="12,8,12,12"
            Spacing="4">
            <TextBlock
                Name="MusicTitleTextBlock"
                FontSize="22"
                Text="尚未播放"
                TextWrapping="Wrap" />
            <TextBlock
                Name="SourceTypeTextBlock"
                Opacity="0.75"
                TextWrapping="Wrap" />
            <TextBlock
                Name="TagEngineTextBlock"
                Opacity="0.75"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0" Spacing="8">
                <TextBox
                    Name="TitleTextBox"
                    Header="标题"
                    IsEnabled="False"
                    TextChanged="EditorField_TextChanged" />

                <TextBox
                    Name="ArtistNamesTextBox"
                    AcceptsReturn="True"
                    Header="艺术家（每行一个）"
                    IsEnabled="False"
                    MinHeight="72"
                    TextChanged="EditorField_TextChanged"
                    TextWrapping="Wrap" />

                <TextBox
                    Name="AlbumTitleTextBox"
                    Header="专辑"
                    IsEnabled="False"
                    TextChanged="EditorField_TextChanged" />

                <TextBox
                    Name="AlbumArtistNameTextBox"
                    Header="专辑艺术家"
                    IsEnabled="False"
                    TextChanged="EditorField_TextChanged" />

                <TextBox
                    Name="GenreTextBox"
                    Header="流派"
                    IsEnabled="False"
                    TextChanged="EditorField_TextChanged" />

                <TextBox
                    Name="YearTextBox"
                    Header="年份"
                    IsEnabled="False"
                    TextChanged="EditorField_TextChanged" />

                <TextBox
                    Name="TrackNumberTextBox"
                    Header="音轨号"
                    IsEnabled="False"
                    TextChanged="EditorField_TextChanged" />

                <TextBox
                    Name="DiscNumberTextBox"
                    Header="碟片号"
                    IsEnabled="False"
                    TextChanged="EditorField_TextChanged" />

                <TextBlock
                    Name="DiscNumberHintTextBlock"
                    Opacity="0.7"
                    TextWrapping="Wrap" />

                <TextBox
                    Name="ComposerTextBox"
                    Header="作曲家"
                    IsEnabled="False"
                    TextChanged="EditorField_TextChanged" />

                <TextBox
                    Name="CommentTextBox"
                    AcceptsReturn="True"
                    Header="注释"
                    IsEnabled="False"
                    MinHeight="80"
                    TextChanged="EditorField_TextChanged"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="3"
            Margin="12"
            Text="标签编辑器尚未初始化。"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
