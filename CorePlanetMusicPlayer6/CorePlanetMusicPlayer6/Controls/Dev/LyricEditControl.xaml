<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.LyricEditControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Name="ReloadLyricsButton"
                    Click="ReloadLyricsButton_Click"
                    Icon="Refresh"
                    IsEnabled="False"
                    Label="重新加载" />

                <AppBarButton
                    Name="SaveLyricsButton"
                    Click="SaveLyricsButton_Click"
                    Icon="Save"
                    IsEnabled="False"
                    Label="保存歌词" />
            </CommandBar.PrimaryCommands>

            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Name="WriteEmbeddedLyricsButton"
                    Click="WriteEmbeddedLyricsButton_Click"
                    IsEnabled="False"
                    Label="写入内嵌歌词"
                    Visibility="Collapsed" />

                <AppBarButton
                    Name="SaveToApplicationButton"
                    Click="SaveToApplicationButton_Click"
                    IsEnabled="False"
                    Label="保存至应用中"
                    Visibility="Collapsed" />

                <AppBarButton
                    Name="RestoreSourceLyricsButton"
                    Click="RestoreSourceLyricsButton_Click"
                    IsEnabled="False"
                    Label="恢复来源歌词" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <StackPanel
            Grid.Row="1"
            Margin="12,8,12,12"
            Spacing="4">

            <TextBlock
                Name="MusicTitleTextBlock"
                FontSize="22"
                Text="尚未播放"
                TextWrapping="Wrap" />

            <TextBlock
                Name="MusicArtistTextBlock"
                Opacity="0.75"
                TextWrapping="Wrap" />

            <ComboBox
                Name="LyricSourceComboBox"
                Header="歌词来源"
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                PlaceholderText="尚未加载歌词"
                SelectionChanged="LyricSourceComboBox_SelectionChanged" />
        </StackPanel>

        <TextBox
            Name="LyricEditorTextBox"
            Grid.Row="2"
            Margin="12,0"
            AcceptsReturn="True"
            Header="LRC 内容"
            IsEnabled="False"
            MinHeight="320"
            PlaceholderText="[00:00.00]在此粘贴带时间标签的歌词"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="LyricEditorTextBox_TextChanged"
            TextWrapping="Wrap" />

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="3"
            Margin="12"
            Text="歌词编辑控件尚未初始化。"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
