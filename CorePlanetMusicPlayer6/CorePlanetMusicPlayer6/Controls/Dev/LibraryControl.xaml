<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.LibraryControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <CommandBar Name="LibraryCommandBar" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Name="AddFolderButton"
                    Click="AddFolderButton_Click"
                    Icon="Add"
                    Label="添加位置" />
                <AppBarButton
                    Name="RemoveFolderButton"
                    Click="RemoveFolderButton_Click"
                    Icon="Delete"
                    Label="移除选中项" />
            </CommandBar.PrimaryCommands>
        </CommandBar>
        <ListView
            Name="LibraryFoldersListView"
            Grid.Row="1"
            SelectionChanged="LibraryFoldersListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding DisplayName}" />
                        <TextBlock
                            Grid.Row="1"
                            Opacity="0.7"
                            Text="{Binding Path}" />
                        <TextBlock
                            Grid.Row="2"
                            Opacity="0.7"
                            Text="{Binding AccessKind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Name="StatusTextBlock" Grid.Row="2" />
    </Grid>
</UserControl>
