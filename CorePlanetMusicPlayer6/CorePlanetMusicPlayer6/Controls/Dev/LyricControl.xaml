<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.LyricControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 操作区域 -->
        <CommandBar
            Name="LyricCommandBar"
            DefaultLabelPosition="Right">

            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Name="ReloadLyricsButton"
                    Click="ReloadLyricsButton_Click"
                    Icon="Refresh"
                    IsEnabled="False"
                    Label="刷新歌词" />

                <AppBarToggleButton
                    Name="FollowLyricsButton"
                    Click="FollowLyricsButton_Click"
                    Icon="Sync"
                    IsChecked="True"
                    IsEnabled="False"
                    Label="自动跟随" />

            </CommandBar.PrimaryCommands>
        </CommandBar>

        <!-- 当前歌曲和歌词信息 -->
        <StackPanel
            Grid.Row="1"
            Margin="12,8,12,12"
            Spacing="4">

            <TextBlock
                Name="MusicTitleTextBlock"
                FontSize="22"
                Text="尚未播放"
                TextWrapping="Wrap" />

            <TextBlock
                Name="MusicArtistTextBlock"
                Opacity="0.75"
                TextWrapping="Wrap" />

            <TextBlock
                Name="LyricInfoTextBlock"
                Opacity="0.75"
                Text="尚未加载歌词"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 滚动歌词区域 -->
        <Grid
            Grid.Row="2"
            MinHeight="220">

            <ListView
                Name="LyricsListView"
                HorizontalContentAlignment="Stretch"
                IsItemClickEnabled="True"
                ItemClick="LyricsListView_ItemClick"
                SelectionMode="None"
                Visibility="Collapsed">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter
                            Property="HorizontalContentAlignment"
                            Value="Stretch" />
                        <Setter
                            Property="Padding"
                            Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Margin="12,10"
                            Opacity="{Binding Opacity}">

                            <StackPanel Spacing="4">

                                <TextBlock
                                    FontSize="25"
                                    FontWeight="Bold"
                                    Text="{Binding Text}"
                                    TextWrapping="WrapWholeWords" />

                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Opacity="0.75"
                                    Text="{Binding TranslationText}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{Binding TranslationVisibility}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 没有可显示歌词时覆盖在列表区域 -->
            <TextBlock
                Name="EmptyLyricsTextBlock"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.65"
                Text="尚未播放歌曲"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>

        <!-- 操作状态 -->
        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="3"
            Margin="12"
            Text="歌词测试控件尚未初始化。"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
