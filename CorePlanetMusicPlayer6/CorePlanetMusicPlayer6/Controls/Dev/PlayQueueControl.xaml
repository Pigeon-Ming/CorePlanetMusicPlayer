<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.PlayQueueControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Name="QueueCommandBar" DefaultLabelPosition="Right">

            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Click="ReloadButton_Click"
                    Icon="Refresh"
                    Label="刷新队列" />

                <AppBarButton
                    Name="PlayButton"
                    Click="PlayButton_Click"
                    Icon="Play"
                    IsEnabled="False"
                    Label="播放选中项" />
            </CommandBar.PrimaryCommands>

            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Name="RemoveButton"
                    Click="RemoveButton_Click"
                    IsEnabled="False"
                    Label="移除选中项" />

                <AppBarButton
                    Name="MoveUpButton"
                    Click="MoveUpButton_Click"
                    IsEnabled="False"
                    Label="上移" />

                <AppBarButton
                    Name="MoveDownButton"
                    Click="MoveDownButton_Click"
                    IsEnabled="False"
                    Label="下移" />

                <AppBarSeparator />

                <AppBarButton
                    Name="ClearButton"
                    Click="ClearButton_Click"
                    IsEnabled="False"
                    Label="停止并清空队列" />

                <AppBarSeparator />

                <AppBarToggleButton
                    Name="RestorePlaybackButton"
                    Click="RestorePlaybackButton_Click"
                    Label="启动时恢复上次播放" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <TextBlock
            Name="SummaryTextBlock"
            Grid.Row="1"
            Text="播放队列 · 普通顺序"
            TextWrapping="Wrap" />

        <ListView
            Name="QueueListView"
            Grid.Row="2"
            SelectionChanged="QueueListView_SelectionChanged"
            SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Number}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding ArtistName}" />
                            <TextBlock Text="{Binding AlbumTitle}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding CurrentText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="3"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
