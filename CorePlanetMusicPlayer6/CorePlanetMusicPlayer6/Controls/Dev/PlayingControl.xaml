<UserControl
    x:Class="CorePlanetMusicPlayer6.Controls.Dev.PlayingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CorePlanetMusicPlayer6.Controls.Dev"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="12" Spacing="12">

            <StackPanel Spacing="4">
                <TextBlock
                    Name="MusicTitleTextBlock"
                    FontSize="22"
                    Text="尚未播放"
                    TextWrapping="Wrap" />

                <TextBlock Name="ArtistNameTextBlock" TextWrapping="Wrap" />

                <TextBlock Name="AlbumTitleTextBlock" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel>
                <Slider
                    Name="PositionSlider"
                    IsEnabled="False"
                    IsThumbToolTipEnabled="False"
                    Maximum="1"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="PositionSlider_ValueChanged" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="PositionTextBlock" Text="00:00" />

                    <TextBlock
                        Name="DurationTextBlock"
                        Grid.Column="1"
                        Text="00:00" />
                </Grid>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Name="PreviousButton"
                    Click="PreviousButton_Click"
                    IsEnabled="False">
                    <FontIcon Glyph="&#xE892;" />
                </Button>

                <Button
                    Name="PlayPauseButton"
                    Click="PlayPauseButton_Click"
                    IsEnabled="False">
                    <FontIcon Name="PlayPauseButtonFontIcon" Glyph="&#xE768;" />
                </Button>

                <Button
                    Name="NextButton"
                    Click="NextButton_Click"
                    IsEnabled="False">
                    <FontIcon Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <ComboBox
                Name="PlaybackModeComboBox"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Value"
                Header="播放模式"
                IsEnabled="False"
                SelectionChanged="PlaybackModeComboBox_SelectionChanged" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Text="音量" />

                <Slider
                    Name="VolumeSlider"
                    Grid.Column="1"
                    Margin="12,0"
                    IsEnabled="False"
                    IsThumbToolTipEnabled="False"
                    Maximum="100"
                    Minimum="0"
                    StepFrequency="1"
                    ValueChanged="VolumeSlider_ValueChanged" />

                <TextBlock
                    Name="VolumeTextBlock"
                    Grid.Column="2"
                    MinWidth="40"
                    VerticalAlignment="Center"
                    Text="100%" />
            </Grid>

            <TextBlock Name="StatusTextBlock" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
